local function colorKey(c)
    return string.format("%d,%d,%d",
        math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function colorProps(d)
    if d:IsA("UIStroke") then return { "Color" } end
    local list = {}
    if d:IsA("GuiObject") then table.insert(list, "BackgroundColor3") end
    if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then table.insert(list, "TextColor3") end
    if d:IsA("TextBox") then table.insert(list, "PlaceholderColor3") end
    if d:IsA("ImageLabel") or d:IsA("ImageButton") then table.insert(list, "ImageColor3") end
    if d:IsA("ScrollingFrame") then table.insert(list, "ScrollBarImageColor3") end
    return list
end

function Library:SetTheme(name)
    local def = self.Themes[name]
    if not def then return false end

    local old = table.clone(Theme)
    for k, v in pairs(def) do Theme[k] = v end
    self.CurrentTheme = name

    local gui = self._gui
    if gui and gui.Parent then
        local map = {}
        for k, oldColor in pairs(old) do
            if typeof(oldColor) == "Color3" then map[colorKey(oldColor)] = Theme[k] end
        end
        for _, d in ipairs(gui:GetDescendants()) do
            for _, prop in ipairs(colorProps(d)) do
                local target = map[colorKey(d[prop])]
                if target then tween(d, { [prop] = target }, 0.25) end
            end
        end
    end
    return true
end

local function neonTransparency(s)
    if not Library.GlowEnabled or not s:GetAttribute("Active") then return 1 end
    return math.clamp(1 - (1 - s:GetAttribute("Base")) * Library.GlowIntensity, 0, 1)
end

local function neon(parent, thickness, base, active)
    local s = create("UIStroke", {
        Name = "Neon",
        Color = Theme.Accent,
        Thickness = thickness,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
    s:SetAttribute("Base", base)
    s:SetAttribute("Active", active ~= false)
    s.Transparency = neonTransparency(s)
    s.Parent = parent
    return s
end

local function setNeonActive(s, active)
    s:SetAttribute("Active", active)
    local prop = s:IsA("UIStroke") and "Transparency" or "BackgroundTransparency"
    tween(s, { [prop] = neonTransparency(s) }, 0.2)
end

function Library:SetGlow(enabled, intensity)
    if enabled ~= nil then self.GlowEnabled = enabled end
    if intensity ~= nil then self.GlowIntensity = intensity end
    local gui = self._gui
    if gui and gui.Parent then
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("UIStroke") and d.Name == "Neon" then
                tween(d, { Transparency = neonTransparency(d) }, 0.2)
            elseif d:IsA("Frame") and d.Name == "NeonBloom" then
                tween(d, { BackgroundTransparency = neonTransparency(d) }, 0.2)
            end
        end
    end
    if self._refreshHalo then self._refreshHalo() end
end

