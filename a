            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Parent = group,
        }, {
            create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
            pad(0, 8, 0, 8),
        })

        local tabData = {
            Button = tabBtn, Label = tabLabel, Page = group, Icon = tabIcon,
            Indicator = indicator, IndNeon = neon(indicator, 2, 0.5, false),
        }
        table.insert(tabs, tabData)

        local function select()
            if activeTab == tabData then return end
            local previous = activeTab
            activeTab = tabData

            for _, t in ipairs(tabs) do
                local active = (t == tabData)
                tween(t.Button, { BackgroundTransparency = active and 0 or 1 })
                tween(t.Label, { TextColor3 = active and Theme.Text or Theme.SubText })
                tween(t.Indicator, { BackgroundTransparency = active and 0 or 1 })
                setNeonActive(t.IndNeon, active)
                setIconActive(t.Icon, active)
            end

            if previous then
                local old = previous.Page
                tween(old, { GroupTransparency = 1, Position = UDim2.fromOffset(0, -8) }, 0.1)
                task.delay(0.1, function()
                    if activeTab ~= previous then old.Visible = false end
                end)
            end

            local new = tabData.Page
            new.Visible = true
            if previous then
                new.GroupTransparency = 1
                new.Position = UDim2.fromOffset(0, 14)
                task.delay(0.08, function()
                    if activeTab == tabData then
                        tween(new, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, 0.3, Enum.EasingStyle.Quint)
                    end
                end)
            else
                new.GroupTransparency = 0
                new.Position = UDim2.fromOffset(0, 0)
            end
        end

        tabBtn.MouseButton1Click:Connect(select)
        tabBtn.MouseEnter:Connect(function()
            if activeTab ~= tabData then tween(tabBtn, { BackgroundTransparency = 0.6 }, 0.1) end
        end)
        tabBtn.MouseLeave:Connect(function()
            if activeTab ~= tabData then tween(tabBtn, { BackgroundTransparency = 1 }, 0.1) end
        end)
        if #tabs == 1 then select() end

