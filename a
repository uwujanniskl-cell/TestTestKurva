    local requestFn =
        request
        or http_request
        or (syn and syn.request)
        or (http and http.request)

    if type(requestFn) ~= "function" then
        warn("No HTTP request function is available in this client.")
        return
    end

    if WEBHOOK_URL == "PASTE_YOUR_NEW_LEADERBOARD_WEBHOOK_URL_HERE" then
        warn("Set WEBHOOK_URL in the leaderboard block to your new Discord webhook URL.")
        return
    end

    -- matches your username or display name
    local function isMe(text)
        text = tostring(text or ""):lower()
        return text == player.Name:lower() or text == player.DisplayName:lower()
    end

    -- 1234567 -> 1.234.567
    local function formatDots(n)
        local s = string.format("%.0f", n)
        local sign, digits = s:match("^(-?)(%d+)$")
        digits = digits:reverse():gsub("(%d%d%d)", "%1."):reverse()
        if digits:sub(1, 1) == "." then
            digits = digits:sub(2)
        end
        return sign .. digits
    end

    local function getLeaderboardResult()
        local leaderboards = workspace:FindFirstChild("Leaderboards")
        local board = leaderboards and leaderboards:FindFirstChild("MostOrdersWeekly")
        local scrolling = board and board:FindFirstChildWhichIsA("ScrollingFrame", true)

        if not scrolling then
            return nil, "MostOrdersWeekly leaderboard UI is unavailable."
        end

        for _, row in ipairs(scrolling:GetChildren()) do
            local nameLabel = row:FindFirstChild("PlayerName", true)

            if nameLabel and nameLabel:IsA("TextLabel") and isMe(nameLabel.Text) then
                local rankLabel = row:FindFirstChild("Rank", true)
                local statLabel = row:FindFirstChild("Stat", true)

                if not (rankLabel and rankLabel:IsA("TextLabel") and statLabel and statLabel:IsA("TextLabel")) then
                    return nil, "Leaderboard row is missing its rank or order label."
                end

                return { rank = rankLabel.Text, orders = statLabel.Text }
            end
        end

        return { rank = "-", orders = "-" }
    end

    local function getMoneyResult()
        local balance = player:FindFirstChild("Moneyz")
            or player:FindFirstChild("Moneyz", true)

        local current = "unavailable"
        if balance and (balance:IsA("IntValue") or balance:IsA("NumberValue")) then
            current = formatDots(balance.Value)
        end

        local listText = "unavailable"
        local reason
        local playerGui = player:FindFirstChildOfClass("PlayerGui")
        local mainGui = playerGui and playerGui:FindFirstChild("MainGui")
        local playerList = mainGui and mainGui:FindFirstChild("PlayerList", true)

        if not playerList then
            reason = "Player list not found."
        else
            for _, row in ipairs(playerList:GetChildren()) do
                local nameLabel = row:FindFirstChild("PlayerName", true)

                if nameLabel and nameLabel:IsA("TextLabel") and isMe(nameLabel.Text) then
                    local moneyLabel = row:FindFirstChild("Moneyz", true)
                    if moneyLabel and moneyLabel:IsA("TextLabel") then
                        listText = moneyLabel.Text
