function Library:CreateWindow(config)
    config = config or {}
    local title = config.Title or "Modern GUI"
    local subtitle = config.Subtitle or ""
    local toggleKey = config.ToggleKey or Enum.KeyCode.RightShift
    if config.Theme and Library.Themes[config.Theme] then Library:SetTheme(config.Theme) end
    if config.Accent then Theme.Accent = config.Accent end
    if config.Glow == false then Library.GlowEnabled = false end
    if config.GlowIntensity then Library.GlowIntensity = config.GlowIntensity end

    removeOld()

    local gui = create("ScreenGui", {
        Name = GUI_NAME,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        DisplayOrder = 999,
    })
    parentGui(gui)
    Library._gui = gui

    -- MOBILE / SMALL SCREEN SUPPORT: the window is scaled so it always fits the screen
    local WIN_W, WIN_H = 600, 400
    local function fitScale()
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        return math.clamp(math.min((vp.X - 16) / WIN_W, (vp.Y - 16) / WIN_H), 0.4, 1)
    end
    local userScaled = config.Scale ~= nil   -- true once a scale was chosen manually
    local baseScale = config.Scale or fitScale()

    local main = create("Frame", {
        Name = "Main",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(WIN_W, WIN_H),
        Position = UDim2.fromScale(0.5, 0.5),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = gui,
    })

    local shown = true
    local HALO_LAYERS = 16
    local haloAlpha = {}
    local haloLayers = {}
    for i = 1, HALO_LAYERS do
        local s = i * 2
        haloAlpha[i] = 0.009 + 0.008 * (1 - i / HALO_LAYERS) ^ 2
        haloLayers[i] = create("Frame", {
            Name = "Halo" .. i,
            Position = UDim2.fromOffset(-s, -s),
            Size = UDim2.new(1, s * 2, 1, s * 2),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Parent = main,
        }, { corner(12 + s) })
    end
    Library._refreshHalo = function()
        for i, layer in ipairs(haloLayers) do
            local t = (shown and Library.GlowEnabled) and math.clamp(1 - haloAlpha[i] * Library.GlowIntensity, 0, 1) or 1
            tween(layer, { BackgroundTransparency = t }, 0.25)
        end
    end
    Library._refreshHalo()

    local body = create("CanvasGroup", {
        Name = "Body",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        GroupTransparency = 1,
        Parent = main,
    }, { corner(12), stroke(Theme.Stroke, 1) })
    tween(body, { GroupTransparency = 0 }, 0.3)

    local edge = create("Frame", {
