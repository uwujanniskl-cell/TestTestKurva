            table.insert(fields, { name = "Notes", value = table.concat(errors, "\n"), inline = false })
        end

        local ok, response = pcall(function()
            return requestFn({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({
