    local buttonLetter = config.ButtonText or string.upper(string.match(title, "%w") or "D")

    local function applyMenuButton()
        local btn = menuButton
        if not btn then return end
        local id = buttonImage
        if type(id) == "number" and id > 0 then
            id = "rbxassetid://" .. id
        elseif type(id) == "string" and tonumber(id) then
            id = "rbxassetid://" .. id
        end
        local mine = btn:FindFirstChild("DroolIcon")
        if type(id) == "string" and id ~= "" then
            if not mine then
                mine = Instance.new("ImageLabel")
                mine.Name = "DroolIcon"
                mine.BackgroundTransparency = 1
                mine.AnchorPoint = Vector2.new(0.5, 0.5)
                mine.Position = UDim2.fromScale(0.5, 0.5)
                mine.Size = UDim2.fromScale(0.54, 0.54)
                mine.ScaleType = Enum.ScaleType.Fit
                mine.ZIndex = btn.ZIndex + 2
                mine.Parent = btn
            end
            mine.Image = id
            mine.Visible = true
            btn.Text = ""
        else
            if mine then mine.Visible = false end
            btn.Text = buttonLetter
        end
    end

    function Window:SetButtonImage(img)
        buttonImage = img
