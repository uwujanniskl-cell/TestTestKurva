Tab:AddSection("Delivery Stuff")

do
    local VIM = game:GetService("VirtualInputManager")
    local player = Players.LocalPlayer
    local ffc = game.FindFirstChild

    local Delivery = {
        enabled = false,
        runId = 0,
        deliverAt = 15,
        delTick = 0,
    }

    pcall(function()
        local getreg_ = getreg or debug.getregistry
        if not (getreg_ and getconstants and setconstant) then return end
        for _, f in ipairs(getreg_()) do
            if type(f) == "function" and tostring(getfenv(f).script) == "Music" then
                local loc = false
                for ci, c in next, getconstants(f) do
                    if c == "location changed" then
                        loc = true
                    elseif loc and c == "SendData" then
                        setconstant(f, ci, "ExplodeString")
                        break
                    end
                end
            end
        end
    end)

    local function getChar()
        local char = player.Character
        if not char then return end
        local root = ffc(char, "HumanoidRootPart")
        local hum = ffc(char, "Humanoid")
        if root and hum then return char, root, hum end
    end

    local function isRunning(id)
        return Delivery.enabled and Delivery.runId == id
    end

    local function smoothTP2(cf, id)
        local _, root, hum = getChar()
        if not root then return end
        local cf0 = (cf - cf.p) + root.Position + Vector3.new(0, 4, 0)
        local diff = cf.p - root.Position
        local oldg = workspace.Gravity
        workspace.Gravity = 0
        for i = 0, diff.Magnitude, 0.9 do
            if not isRunning(id) then break end
            hum.Sit = false
            root.CFrame = cf0 + diff.Unit * i
            root.Velocity, root.RotVelocity = Vector3.new(), Vector3.new()
            wait()
        end
        root.CFrame = cf
        workspace.Gravity = oldg
    end

    local function smoothTP(cf, id)
        local _, root = getChar()
        if not root then return end
        if (cf.p - root.Position).Magnitude > 95 then
            local btns = workspace.JobButtons:GetChildren()
            if player:FindFirstChild("House") and player.House.Value then
                local marker = player.House.Value:FindFirstChild("Marker")
                if marker then btns[#btns + 1] = marker end
            end
            table.sort(btns, function(a, b)
                return (a.Position - cf.p).Magnitude < (b.Position - cf.p).Magnitude
            end)
            if btns[1] and (btns[1].Position - cf.p).Magnitude < (cf.p - root.Position).Magnitude then
                ReplicatedStorage.PlayerChannel:FireServer(
                    "TeleportToJob",
                    (btns[1].Name == "Marker") and "House" or btns[1].Name
                )
                wait(0.7)
                if (cf.p - root.Position).Magnitude < 8 then return end
            end
        end
        smoothTP2(cf, id)
    end

    local function FindAllDeliveryTools(parent)
        local t = {}
        for _, v in ipairs(parent:GetChildren()) do
            if v.ClassName == "Tool" and v.Name:match("^%u%d$") and ffc(v, "Handle") and ffc(v, "House")
                and (parent ~= workspace or (v.Handle.Position - Vector3.new(54.45, 4.02, -16.56)).Magnitude < 30) then
                t[#t + 1] = v
            end
        end
        return t
    end

    local function getHousePart(address)
        for _, h in ipairs(workspace.Houses:GetChildren()) do
            if ffc(h, "Address") and h.Address.Value == address and ffc(h, "GivePizza", true) then
                return ffc(h, "GivePizza", true)
            end
        end
    end

    local function deliveryStep(id)
        local char, root, hum = getChar()
        if not char then return end

        local wstools = FindAllDeliveryTools(workspace)
        if #wstools > 1 or (wstools[1] and ffc(wstools[1].Handle, "X10")) then
            if (root.Position - Vector3.new(54.45, 4.02, -15)).Magnitude > 9 then
                smoothTP(CFrame.new(54.45, 4.02, -15), id)
                wait(0.1)
            end
            for _, tool in ipairs(wstools) do
                if not isRunning(id) then return end
                if tool.Parent == workspace then
                    hum:EquipTool(tool)
                    wait()
                end
            end
            wait(0.5)
            for _, t in ipairs(FindAllDeliveryTools(char)) do
                t.Parent = player.Backpack
            end
            wait(0.1)
            if ffc(char, "RightHand") and ffc(char.RightHand, "RightGrip") then
                char.RightHand.RightGrip:Destroy()
            end
        end

        local bptools = FindAllDeliveryTools(player.Backpack)
        if #bptools >= Delivery.deliverAt and #bptools > 0 and tick() - Delivery.delTick > 30 then
            table.sort(bptools, function(a, b)
                a, b = tostring(a), tostring(b)
                if a:sub(1, 1) == "B" and b:sub(1, 1) == "B" then
                    return a < b
                end
                return a > b
            end)

            local function delivered(t)
                return t.Parent ~= char and t.Parent ~= player.Backpack
            end

            for _, tool in ipairs(bptools) do
                if not isRunning(id) then break end
                local _, r, h = getChar()
                if not r then break end
                h.Sit = false

                if not delivered(tool) then
                    local giver = getHousePart(tool.Name)
                    if giver then
                        if (giver.Position - r.Position).Magnitude > 9 then
                            local ogp = giver.Position
                            smoothTP(giver.CFrame + Vector3.new(0, 7, 0), id)
                            if giver.Parent == nil or (giver.Position - ogp).Magnitude > 1 then
                                giver = getHousePart(tool.Name) or giver
                                smoothTP(giver.CFrame + Vector3.new(0, 7, 0), id)
                            end
                            wait(0.3)
                        end

                        for _ = 1, 3 do
                            if not isRunning(id) or delivered(tool) then break end
                            for _, t in ipairs(FindAllDeliveryTools(char)) do
                                if t ~= tool then t.Parent = player.Backpack end
                            end
                            pcall(function() tool.Parent = char end)

                            local start = tick()
                            while isRunning(id) and not delivered(tool) and tick() - start < 2 do
                                wait(0.1)
                            end
                            if not delivered(tool) then
                                pcall(function() tool.Parent = player.Backpack end)
                                wait(0.3)
                            end
                        end
                    end
                end
            end
            Delivery.delTick = tick()
        end
    end

    local function startDelivery()
        Delivery.runId += 1
        local id = Delivery.runId
        Delivery.enabled = true
        spawn(function()
            while isRunning(id) do
                wait(0.9)
                local _, _, hum = getChar()
                if hum then
                    hum.Sit = false
                    if math.random(1, 20) == 1 then
                        VIM:SendKeyEvent(true, "Z", false, game)
                        wait()
                        VIM:SendKeyEvent(false, "Z", false, game)
                    end
                    local ok, err = pcall(deliveryStep, id)
                    if not ok then warn("Delivery error:", err) end
                end
            end
        end)
    end

    local function stopDelivery()
        Delivery.enabled = false
        Delivery.runId += 1
        workspace.Gravity = 196.2
    end

    Tab:AddToggle({
        Name = "Delivery",
        Default = false,
        Callback = function(Value)
            if Value then
                startDelivery()
            else
                stopDelivery()
            end
        end
    })

    Tab:AddSlider({
        Name = "Deliver At",
        Min = 1,
        Max = 50,
        Default = 15,
        Increment = 1,
        Suffix = " pizzas",
        Callback = function(Value)
            Delivery.deliverAt = Value
        end
    })
end

Tab:AddSection("Supplier Stuff")

do
    local network = Network

    local refillAt, refillEnd = 99, 99
    local supplierSession = 0
    local supplierRefilling = false

    local function getRoot()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        return char:WaitForChild("HumanoidRootPart")
    end

    local function TP(cf)
        getRoot().CFrame = cf
    end

    local function interests(hum, part)
        local cf, size, tr = part.CFrame, part.Size, part.Transparency
        part.Transparency = 1
        part.CanCollide = false
        part.Size = Vector3.new(0.1, 0.1, 0.1)
        for _ = 1, 3 do
            task.wait(0.1)
            part.CFrame = hum.CFrame
        end
        task.wait()
        part.CanCollide = true
        part.CFrame = cf
        part.Size = size
        part.Transparency = tr
    end
    interest = interests -- kill / remove-manager code calls it as "interest"

    local supplyCounts = {TomatoSauce=0, Cheese=0, Sausage=0, Pepperoni=0, Dough=0, Box=0, Dew=0}
    for name in pairs(supplyCounts) do
        local counterName = (name == "Dew") and "CounterMountainDew" or ("Counter" .. name)
        for _, model in ipairs(workspace.SupplyCounters:GetChildren()) do
            local counter = model:FindFirstChild(counterName)
            if counter and counter:FindFirstChild("a") then
                local lbl = counter.a.SG.Counter
                supplyCounts[name] = tonumber(lbl.Text) or 0
                lbl:GetPropertyChangedSignal("Text"):Connect(function()
                    supplyCounts[name] = tonumber(lbl.Text) or 0
                end)
            end
        end
    end

    local SupplyLift = { workspace.SupplyLift, workspace.SupplyLift2 }

    local bcolorToSupply = {
        ["Dark orange"]="Sausage", ["Bright blue"]="Pepperoni", ["Bright yellow"]="Cheese",
        ["Bright red"]="TomatoSauce", ["Dark green"]="Dew", ["Brick yellow"]="Dough",
        ["Light stone grey"]="Box", ["Really black"]="Dew", ["Navy blue"]="Dew",
    }

    local supplyButtons = {}
    for i, v in ipairs(workspace.SupplyButtons:GetChildren()) do
        v.Unpressed.CanCollide = false
        supplyButtons[i] = v.Unpressed
    end

    local function allSupplied()
        for _, count in pairs(supplyCounts) do
            if count < refillEnd then return false end
        end
        return true
    end

    local function runSupplier(session)
        local function alive() return supplierSession == session end
        local busy = {}

        task.spawn(function()
            while alive() do
                task.wait(0.2)
                if supplierRefilling then
                    for _, box in ipairs(workspace.AllSupplyBoxes:GetChildren()) do
                        if not (alive() and supplierRefilling) then break end
                        network:FireServer("UpdateProperty", box, "CFrame", SupplyLift[math.random(1, 2)].CFrame)
                        task.wait(0.2)
                    end
                end
            end
        end)

        while alive() do
            task.wait(0.9)

            local needsRefill = false
            for _, count in pairs(supplyCounts) do
                if count <= refillAt then needsRefill = true break end
            end

            if needsRefill then
                task.wait(2)
                TP(CFrame.new(7, 13, -1022))
                supplierRefilling = true

                while alive() do
                    task.wait(1)

                    for _, btn in ipairs(supplyButtons) do
                        local s = bcolorToSupply[btn.BrickColor.Name]
                        if s and supplyCounts[s] and supplyCounts[s] < refillEnd then
                            btn.CanCollide = false
                            TP(({ CFrame.new(14.15, 12.99, -1049.25), CFrame.new(0.74, 12.99, -1049.67) })[math.random(1, 2)])

                            if not busy[btn] then
                                busy[btn] = true
                                task.spawn(function()
                                    while alive() and supplyCounts[s] < refillEnd do
                                        task.wait()
                                        interests(getRoot(), btn)
                                    end
                                    busy[btn] = nil
                                end)
                            end
                        end
                    end

                    if allSupplied() then
                        task.wait(2)
                        supplierRefilling = false
                        for _, box in ipairs(workspace.AllSupplyBoxes:GetChildren()) do
                            task.wait(0.2)
                            network:FireServer("UpdateProperty", box, "CFrame", CFrame.new(0, -459, 0))
                        end
                        task.wait(2)
                        break
                    end
                end
                supplierRefilling = false
            end
        end
    end

    Tab:AddToggle({
        Name = "Supplier",
        Default = false,
        Callback = function(Value)
            supplierSession += 1
            supplierRefilling = false
            if Value then
                task.spawn(runSupplier, supplierSession)
            end
        end
    })

    Tab:AddSlider({
        Name = "Refill at",
        Min = 0, Max = 99, Default = 99, Increment = 1,
        Suffix = " supplies",
        Callback = function(v) refillAt = v end
    })
    Tab:AddSlider({
        Name = "Refill until",
        Min = 1, Max = 99, Default = 99, Increment = 1,
        Suffix = " supplies",
        Callback = function(v) refillEnd = v end
    })
end

