        function Tab:AddSlider(opts)
            local min, max = opts.Min or 0, opts.Max or 100
            local inc = opts.Increment or 1
            local suffix = opts.Suffix or ""
            local decimals = #(tostring(inc):match("%.(%d+)") or "")
            local value = math.clamp(opts.Default or min, min, max)

            local f = row(56)
            titleLabel(f, opts.Name or "Slider", 28, 2, 90)
            local valueLabel = create("TextLabel", {
                Size = UDim2.fromOffset(80, 28),
                Position = UDim2.new(1, -92, 0, 2),
                BackgroundTransparency = 1,
                Text = tostring(value) .. suffix,
                TextColor3 = Theme.Accent,
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = f,
            })

            local bar = create("Frame", {
                Size = UDim2.new(1, -24, 0, 6),
                Position = UDim2.new(0, 12, 0, 38),
                BackgroundColor3 = Theme.Off,
                BorderSizePixel = 0,
                Parent = f,
            }, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

            local fill = create("Frame", {
                Size = UDim2.fromScale((value - min) / (max - min), 1),
                BackgroundColor3 = Theme.Accent,
                BorderSizePixel = 0,
                Parent = bar,
            }, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

            local thumb = create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.fromOffset(12, 12),
                Position = UDim2.fromScale(1, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                Parent = fill,
            }, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            neon(thumb, 1.5, 0.65, true)

            local function apply(v, silent)
                v = math.clamp(v, min, max)
                v = tonumber(string.format("%." .. decimals .. "f", v))
                value = v
                valueLabel.Text = tostring(v) .. suffix
                tween(fill, { Size = UDim2.fromScale((v - min) / (max - min), 1) }, 0.06)
                if opts.Flag then Library.Flags[opts.Flag] = v end
                if not silent and opts.Callback then task.spawn(opts.Callback, v) end
            end

            local function fromX(x)
                local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                local raw = min + (max - min) * rel
                apply(math.floor(raw / inc + 0.5) * inc)
            end

            local dragging = false
            bar.InputBegan:Connect(function(input)
                if isPointerDown(input) then
                    dragging = true
                    fromX(input.Position.X)
                end
            end)
            connect(UserInputService.InputChanged, function(input)
                if dragging and isPointerMove(input) then fromX(input.Position.X) end
            end)
            connect(UserInputService.InputEnded, function(input)
                if isPointerDown(input) then dragging = false end
            end)

            register(opts.Flag, value, function(v) apply(tonumber(v) or min) end)
            return { Set = function(_, v) apply(v) end, Get = function() return value end }
        end

        function Tab:AddDropdown(opts)
            local options = opts.Options or {}
            local multi = opts.Multi == true
            local selected = {}
            local single = nil
            local open = false

            if multi then
                if type(opts.Default) == "table" then
                    for _, v in ipairs(opts.Default) do selected[v] = true end
                end
            else
                single = opts.Default
                if single == nil then single = options[1] end
            end

            order += 1
            local holder = create("Frame", {
                Size = UDim2.new(1, 0, 0, 40),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Theme.Element,
                BorderSizePixel = 0,
                LayoutOrder = order,
                Parent = page,
            }, { corner(8), create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }) })

            local header = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 40),
                BackgroundTransparency = 1,
                Text = "",
                LayoutOrder = 0,
                Parent = holder,
            })
            hover(holder, header)
            titleLabel(header, opts.Name or "Dropdown", 40, 0, 180)

            local current = create("TextLabel", {
                Size = UDim2.new(0, 160, 1, 0),
                Position = UDim2.new(1, -172, 0, 0),
                BackgroundTransparency = 1,
                TextColor3 = Theme.Accent,
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = header,
            })

            local function listHeight() return #options * 30 + 4 end
            local list = create("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                BackgroundTransparency = 1,
                ClipsDescendants = true,
                LayoutOrder = 1,
                Parent = holder,
            }, {
                create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
                pad(0, 6, 6, 6),
            })

            local optionButtons = {}

            local function displayText()
                if multi then
                    local names = {}
                    for _, o in ipairs(options) do
                        if selected[o] then table.insert(names, tostring(o)) end
                    end
                    if #names == 0 then return "None" end
                    if #names <= 2 then return table.concat(names, ", ") end
                    return #names .. " selected"
                end
                return tostring(single)
            end

            local function currentValue()
                if multi then
                    local names = {}
                    for _, o in ipairs(options) do
                        if selected[o] then table.insert(names, o) end
                    end
                    return names
                end
                return single
            end

            local function refresh()
                for opt, btn in pairs(optionButtons) do
                    local on = multi and selected[opt] or (not multi and single == opt)
                    tween(btn, { TextColor3 = on and Theme.Accent or Theme.SubText }, 0.15)
                    btn.Font = on and Enum.Font.GothamBold or Enum.Font.Gotham
                end
                current.Text = displayText() .. (open and "  ^" or "  v")
            end

            local function fire(silent)
                local v = currentValue()
                if opts.Flag then Library.Flags[opts.Flag] = v end
                if not silent and opts.Callback then task.spawn(opts.Callback, v) end
            end

            local function build()
                for _, c in ipairs(list:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                table.clear(optionButtons)
                for i, item in ipairs(options) do
                    local opt = create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 28),
                        BackgroundColor3 = Theme.ElementHi,
                        BackgroundTransparency = 1,
                        Text = tostring(item),
                        TextColor3 = Theme.SubText,
                        Font = Enum.Font.Gotham,
                        TextSize = 12,
                        AutoButtonColor = false,
                        LayoutOrder = i,
                        Parent = list,
                    }, { corner(6) })
                    optionButtons[item] = opt
                    opt.MouseEnter:Connect(function() tween(opt, { BackgroundTransparency = 0 }, 0.1) end)
                    opt.MouseLeave:Connect(function() tween(opt, { BackgroundTransparency = 1 }, 0.1) end)
                    opt.MouseButton1Click:Connect(function()
                        if multi then
                            selected[item] = not selected[item] or nil
                        else
                            single = item
                            open = false
                            tween(list, { Size = UDim2.new(1, 0, 0, 0) }, 0.2, Enum.EasingStyle.Quint)
                        end
                        refresh()
                        fire()
                    end)
                end
                refresh()
            end

            header.MouseButton1Click:Connect(function()
                open = not open
                refresh()
                tween(list, { Size = UDim2.new(1, 0, 0, open and listHeight() or 0) }, 0.22, Enum.EasingStyle.Quint)
            end)

            local function set(v, silent)
                if multi then
                    table.clear(selected)
                    if type(v) == "table" then
                        for _, x in ipairs(v) do selected[x] = true end
                    end
                else
                    single = v
                end
                refresh()
                fire(silent)
            end

            build()
            if opts.Flag then Library.Flags[opts.Flag] = currentValue() end
            register(opts.Flag, currentValue(), function(v) set(v) end)

            return {
                Set = function(_, v) set(v) end,
                Get = currentValue,
                Refresh = function(_, newOptions)
                    options = newOptions
                    build()
                    if open then tween(list, { Size = UDim2.new(1, 0, 0, listHeight()) }, 0.2) end
                end,
            }
        end

