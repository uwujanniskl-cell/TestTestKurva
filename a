Tab:AddSection("Inventory")

do
    local inventoryList = LocalPlayer.PlayerGui.MainGui.Menu.Inventory.ScrollingFrame.List
    local playerChannel = ReplicatedStorage:WaitForChild("PlayerChannel")

    local function extractAssetId(imageUrl)
        local id = string.match(imageUrl, "AssetID=(%d+)")
        return tonumber(id)
    end

    local selling = false

    Tab:AddToggle({
        Name = "Auto Sell",
        Default = false,
        Callback = function(Value)
            selling = Value

            if selling then
                task.spawn(function()
                    while selling do
                        for _, item in ipairs(inventoryList:GetChildren()) do
                            if not selling then break end

                            local thumbnail = item:FindFirstChild("Thumbnail")
                            if thumbnail and thumbnail:IsA("ImageLabel") then
                                local assetId = extractAssetId(thumbnail.Image)
                                if assetId then
                                    playerChannel:FireServer("SellInventoryItem", assetId)
                                end
                            end
                        end
                        task.wait()
                    end
                end)
            end
        end
    })
end

Tab:AddSection("Presents")

do
    local running = false

    local function sellAllWrappedItems()
        local backpack = LocalPlayer:WaitForChild("Backpack")
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

        for _, v in pairs(backpack:GetChildren()) do
            if v.Name == "Normal" and v:FindFirstChild("Rarity") then
                if v:FindFirstChild("PresentCamera") then
                    v.PresentCamera.Disabled = true
                end
                local id = v:FindFirstChild("RewardAssetId") and v.RewardAssetId.Value
                if id then
                    v.Parent = character
                    ReplicatedStorage:WaitForChild("PlayerChannel"):FireServer("PutUnwrappedItemInInventory", id)
                    ReplicatedStorage:WaitForChild("PlayerChannel"):FireServer("SellInventoryItem", id)
                    v:Destroy()
                end
            end
        end
    end

    local function autoSellLoop()
        while running do
            local backpack = LocalPlayer:WaitForChild("Backpack")
            local normalCount = 0
            for _, item in pairs(backpack:GetChildren()) do
                if item.Name == "Normal" then
                    normalCount = normalCount + 1
                end
            end
            if normalCount > 5 then
                sellAllWrappedItems()
            end
            task.wait(1)
        end
    end

    local function autoBuyLoop()
        while running do
            workspace.PresentTable.Presents.Normal.ClickDetector.Detector:FireServer()
            task.wait()
            local Buy = LocalPlayer.PlayerGui.Gui.BuyPresent.Body.Buttons.Buy
            if Buy and Buy:IsA("TextButton") and getconnections then
                for _, connection in pairs(getconnections(Buy.MouseButton1Click)) do
                    connection.Function()
                end
            end
        end
    end

    Tab:AddToggle({
        Name = "Buy + Sell",
        Default = false,
        Callback = function(Value)
            running = Value
            if running then
                task.spawn(autoBuyLoop)
                task.spawn(autoSellLoop)
            end
        end
    })
end

