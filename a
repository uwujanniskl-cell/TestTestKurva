                btn.Text = "..."
                tween(btn, { BackgroundColor3 = Theme.Accent })
                btn.TextColor3 = Theme.Text
            end)

            connect(UserInputService.InputBegan, function(input, processed)
                if listening then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        listening = false
                        task.delay(0.1, function() Library._listening = false end)
                        tween(btn, { BackgroundColor3 = Theme.ElementHi })
                        btn.TextColor3 = Theme.Accent
                        if input.KeyCode == Enum.KeyCode.Escape then setKey(nil) else setKey(input.KeyCode) end
                    end
                    return
                end
                if not processed and key and input.KeyCode == key and opts.Callback then
                    task.spawn(opts.Callback)
                end
            end)

            register(opts.Flag, key and key.Name or "", function(v)
                local ok, k = pcall(function() return Enum.KeyCode[v] end)
                setKey(ok and k or nil)
            end)
            return { Set = function(_, k) setKey(k) end, Get = function() return key end }
        end

        return Tab
    end

