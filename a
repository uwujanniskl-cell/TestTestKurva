Tab:AddSection("Cashier Stuff")

do
    local CashierRunning = false
    local CashierWorkerRunning = false
    local hiddenFloors = {}
    local cashierPosition = Vector3.new(48.7329979, 6.00011444, 88.8772278, 0.999997616, -3.50909275e-08, 0.00218225247, 3.52477656e-08, 1, -7.18306907e-08, -0.00218225247, 7.19074364e-08, 0.999997616)

    for _, instance in ipairs(workspace:GetDescendants()) do
        if instance:IsA("BasePart")
            and ((instance.Position.Y <= 1 and instance.Transparency < 1 and instance.Position.Z >= 76)
                or instance.Name == "BasePlate"
                or instance.Name == "Street") then
            hiddenFloors[instance] = {
                CanCollide = instance.CanCollide,
                Transparency = instance.Transparency,
            }
        end
    end

    local function setFloorsHidden(hidden)
        for floor, original in pairs(hiddenFloors) do
            if floor.Parent then
                if hidden then
                    floor.CanCollide = false
                    floor.Transparency = 1
                else
                    floor.CanCollide = original.CanCollide
                    floor.Transparency = original.Transparency
                end
            end
        end
    end

    local function handleCashierCustomers()
        LocalPlayer.SimulationRadius = 99999999999

        for _, customer in ipairs(workspace.Customers:GetChildren()) do
            local humanoid = customer:FindFirstChild("Humanoid")
            local head = customer:FindFirstChild("Head")
            local dialog = head and head:FindFirstChild("Dialog")
            local correctDialog = dialog and dialog:FindFirstChild("Correct")

            if humanoid and customer:FindFirstChild("HumanoidRootPart") and correctDialog then
                local response = correctDialog.ResponseDialog or ""
                if response:sub(-8) == "instead." then
                    response = response:sub(-30)
                end
                local pizza = "MountainDew"

                if response:find("pepperoni", 1, true) then
                    pizza = "PepperoniPizza"
                elseif response:find("sausage", 1, true) then
                    pizza = "SausagePizza"
                elseif response:find("cheese", 1, true) then
                    pizza = "CheesePizza"
                end

                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - cashierPosition).Magnitude > 9 then
                    root.CFrame = CFrame.new(cashierPosition)
                    task.wait(0.1)
                end

                Network:FireServer(
                    "OrderComplete",
                    customer,
                    pizza,
                    humanoid.Sit and workspace.Register3 or workspace.Register2
                )
            end
        end
    end

    Tab:AddToggle({
        Name = "Cashier",
        Default = false,
        Callback = function(Value)
            CashierRunning = Value

            if not Value then
                setFloorsHidden(false)
                return
            end

            if CashierWorkerRunning then
                return
            end

            CashierWorkerRunning = true
            task.spawn(function()
                while CashierRunning do
                    handleCashierCustomers()
                    setFloorsHidden(true)
                    task.wait(0.9)
                end

                setFloorsHidden(false)
                CashierWorkerRunning = false
            end)
        end
    })
end

Tab:AddSection("Cook Stuff")

do
    local cookEnabled = false


    Tab:AddToggle({
        Name = "Cook",
        Default = false,
        Callback = function(Value)
            cookEnabled = Value

            if not Value then
                return
            end

            task.spawn(function()
                local player = Players.LocalPlayer
                local network = Network
                local RNG = Random.new()

                local orderDict = {
                    ["3540529228"] = "Cheese",
                    ["3540530535"] = "Sausage",
                    ["3540529917"] = "Pepperoni",
                    ["2512571151"] = "Dew",
                    ["2512441325"] = "Dew",
                    ["11874352009"] = "Dew"
                }

                local cookingDict = {
                    Cheese = 0,
                    Sausage = 0,
                    Pepperoni = 0,
                    Dew = 0
                }

                local cookPizzaTick = 0
                local cookDewTick = 0

                local function getRoot()
                    local character = player.Character
                    return character and character:FindFirstChild("HumanoidRootPart")
                end

                local function teleportToKitchen()
                    local root = getRoot()
                    if root and (root.Position - Vector3.new(45.32, 6.52, 48.81)).Magnitude > 9 then
                        root.CFrame = CFrame.new(45.32, 6.52, 48.81)
                    end
                end

                local function getSupplyCount(name)
                    local counterName = name == "Dew" and "CounterMountainDew" or "Counter" .. name

                    for _, counter in ipairs(workspace.SupplyCounters:GetChildren()) do
                        local display = counter:FindFirstChild(counterName)
                        local container = display and display:FindFirstChild("a")
                        local gui = container and container:FindFirstChild("SG")
                        local label = gui and gui:FindFirstChild("Counter")

                        if label then
                            return tonumber(label.Text) or 0
                        end
                    end

                    return 0
                end

                local function getOrders()
                    local orders = {}
                    local pending = {}

                    for name, count in pairs(cookingDict) do
                        pending[name] = count
                    end

                    for _, order in ipairs(workspace.Orders:GetChildren()) do
                        local sg = order:FindFirstChild("SG")
                        local imageLabel = sg and sg:FindFirstChild("ImageLabel")
                        local image = imageLabel and imageLabel.Image
                        local id = image and image:match("%d+$")
                        local item = id and orderDict[id]

                        if item then
                            if pending[item] and pending[item] > 0 then
                                pending[item] = pending[item] - 1
                            elseif item == "Dew" then
                                if #workspace.AllMountainDew:GetChildren() > 0 then
                                    table.insert(orders, item)
                                end
                            elseif getSupplyCount(item) > 0
                                and getSupplyCount("TomatoSauce") > 0
                                and getSupplyCount("Cheese") > 0 then
                                table.insert(orders, item)
                            end
                        end
                    end

                    return orders
                end

                local function findFirstDew()
                    for _, dew in ipairs(workspace.AllMountainDew:GetChildren()) do
                        local burned = dew:FindFirstChild("IsBurned")
                        if (not burned or not burned.Value) and not dew.Anchored then
                            return dew
                        end
                    end
                end

                local function findBadDew()
                    for _, dew in ipairs(workspace.AllMountainDew:GetChildren()) do
                        local burned = dew:FindFirstChild("IsBurned")
                        if (not burned or not burned.Value)
                            and dew.Position.X > 53
                            and dew.Position.Z > 50
                            and not dew.Anchored then
                            return dew
                        end
                    end
                end

                local function findDoughAndWithout(excludedTopping)
                    local goodRaw, cookedPizza, rawDough, trash
                    local doughList = workspace.AllDough:GetChildren()

                    for i = #doughList, 2, -1 do
                        local j = RNG:NextInteger(1, i)
                        doughList[j], doughList[i] = doughList[i], doughList[j]
                    end

                    for _, dough in ipairs(doughList) do
                        if not dough.Anchored and #dough:GetChildren() > 9 then
                            local burned = dough:FindFirstChild("IsBurned")
                            local bugs = dough:FindFirstChild("HasBugs")
                            local cold = dough:FindFirstChild("Cold")
                            local isBad = (burned and burned.Value)
                                or (bugs and bugs.Value)
                                or (cold and cold.Value)
                                or (dough.BrickColor.Name == "Bright orange" and dough:FindFirstChild("XBillboard"))

                            if isBad then
                                if not trash
                                    and dough.Position.Y > 0
                                    and ((dough.Position * Vector3.new(1, 0, 1))
                                        - Vector3.new(47.90, 0, 72.49)).Magnitude > 1 then
                                    trash = dough
                                end
                            elseif not cookedPizza and dough.BrickColor.Name == "Bright orange" then
                                cookedPizza = dough
                            elseif dough.Position.X < 55
                                and dough.BrickColor.Name == "Brick yellow" then
                                local sg = dough:FindFirstChild("SG")
                                local frame = sg and sg:FindFirstChild("Frame")
                                local hasExcludedTopping = excludedTopping
                                    and frame
                                    and frame:FindFirstChild(excludedTopping)
                                local hasSausage = frame and frame:FindFirstChild("Sausage")
                                local hasPepperoni = frame and frame:FindFirstChild("Pepperoni")

                                if not hasExcludedTopping
                                    and (excludedTopping or (not hasSausage and not hasPepperoni)) then
                                    local mesh = dough:FindFirstChild("Mesh")
                                    if mesh and mesh.Scale.Y < 1.1 then
                                        goodRaw = goodRaw or dough
                                    else
                                        rawDough = rawDough or dough
                                    end
                                end
                            end

                            if goodRaw and cookedPizza and trash then
                                return goodRaw, cookedPizza, trash
                            end
                        end
                    end

                    return goodRaw or rawDough, cookedPizza, trash
                end

                local function getOvenNear(position)
                    for _, oven in ipairs(workspace.Ovens:GetChildren()) do
                        local bottom = oven:FindFirstChild("Bottom")
                        if bottom and (bottom.Position - position).Magnitude < 1.5 then
                            return oven
                        end
                    end
                end

                local function getDoughNear(position)
                    for _, dough in ipairs(workspace.AllDough:GetChildren()) do
                        if (dough.Position - position).Magnitude < 1.5 then
                            return dough
                        end
                    end
                end

                local function isFullyOpen(oven)
                    local door = oven:FindFirstChild("Door")
                    local meter = door and door:FindFirstChild("Meter")
                    return oven.IsOpen.Value
                        and meter
                        and math.abs(meter.RotVelocity.Z) < 0.0001
                end

                -- squish: remote learned from the game's own call (see Learned above)
                local function squishDough(dough)
                    local ok, err = pcall(fireLearned,
                        "\x01:Dough", "\x01", dough,
                        "Squish one dough by hand once so I can learn the remote.")
                    if not ok then warn("squishDough failed:", err) end
                end

                local function cookStep()
                    local orders = getOrders()
                    local order = orders[1]
                    local topping = (order == "Pepperoni" or order == "Sausage") and order or nil
                    local cookDew = findFirstDew()
                    local badDew = findBadDew()
                    local raw, cookedPizza, trash

                    if topping then
                        raw, cookedPizza, trash = findDoughAndWithout(
                            topping == "Pepperoni" and "Sausage" or "Pepperoni"
                        )
                    else
                        raw, cookedPizza, trash = findDoughAndWithout()
                    end

                    local ovens = workspace.Ovens:GetChildren()
                    for i = #ovens, 1, -1 do
                        if #ovens[i]:GetChildren() < 10 then
                            table.remove(ovens, i)
                        end
                    end

                    for i = #ovens, 2, -1 do
                        local j = RNG:NextInteger(1, i)
                        ovens[j], ovens[i] = ovens[i], ovens[j]
                    end

                    local didSomething = false

                    if cookedPizza and tick() - cookPizzaTick > 0.8 then
                        local oven = getOvenNear(cookedPizza.Position)
                        if not oven or oven.IsOpen.Value then
                            cookPizzaTick = tick()
                            didSomething = true
                            teleportToKitchen()
                            network:FireServer(
                                "UpdateProperty",
                                cookedPizza,
                                "CFrame",
                                CFrame.new(RNG:NextNumber(56, 57), 4.1, 38)
                            )
                        end
                    end

                    if order == "Dew" and cookDew and tick() - cookDewTick > 0.8 then
                        cookDewTick = tick()
                        didSomething = true
                        teleportToKitchen()
                        network:FireServer(
                            "UpdateProperty",
                            cookDew,
                            "CFrame",
                            CFrame.new(53, 4.68, 36.5)
                        )
                    elseif order and order ~= "Dew" and raw and raw.Parent
                        and getSupplyCount(order) > 0
                        and getSupplyCount("TomatoSauce") > 0
                        and getSupplyCount("Cheese") > 0 then
                        local mesh = raw:FindFirstChild("Mesh")

                        if mesh and mesh.Scale.Y > 1.5 then
                            teleportToKitchen()
                            didSomething = true
                            network:FireServer(
                                "UpdateProperty",
                                raw,
                                "CFrame",
                                CFrame.new(RNG:NextNumber(29.6, 44.6), 3.7, RNG:NextNumber(42.5, 48.5))
                            )
                            task.wait()
                            squishDough(raw)
                        else
                            local oven

                            for _, candidate in ipairs(ovens) do
                                if isFullyOpen(candidate) then
                                    local other = getDoughNear(candidate.Bottom.Position)
                                    local sg = other and other:FindFirstChild("SG")
                                    local frame = sg and sg:FindFirstChild("Frame")
                                    local isFinishedPizza = other
                                        and other.BrickColor.Name == "Bright orange"
                                        and frame
                                        and frame:FindFirstChild("TomatoSauce")
                                        and frame:FindFirstChild("MeltedCheese")

                                    if not isFinishedPizza then
                                        if other then
                                            didSomething = true
                                            teleportToKitchen()
                                            network:FireServer(
                                                "UpdateProperty",
                                                other,
                                                "CFrame",
                                                CFrame.new(
                                                    RNG:NextNumber(29.6, 44.6),
                                                    3.7,
                                                    RNG:NextNumber(42.5, 48.5)
                                                )
                                            )
                                            task.wait()
                                        end

                                        oven = candidate
                                        break
                                    end
                                end
                            end

                            if oven and raw.Parent == workspace.AllDough then
                                teleportToKitchen()
                                didSomething = true
                                network:FireServer("AddIngredientToPizza", raw, "Cheese")
                                network:FireServer("AddIngredientToPizza", raw, "TomatoSauce")
                                network:FireServer("AddIngredientToPizza", raw, topping)
                                network:FireServer(
                                    "UpdateProperty",
                                    raw,
                                    "CFrame",
                                    oven.Bottom.CFrame + Vector3.new(0, 0.7, 0)
                                )

                                local door = oven:FindFirstChild("Door")
                                local clickDetector = door and door:FindFirstChild("ClickDetector")
                                local detector = clickDetector and clickDetector:FindFirstChild("Detector")
                                if detector then
                                    detector:FireServer()
                                end

                                cookingDict[order] = cookingDict[order] + 1
                                local revoked = false

                                task.spawn(function()
                                    raw.AncestryChanged:Wait()
                                    if not revoked then
                                        cookingDict[order] = cookingDict[order] - 1
                                        revoked = true
                                    end
                                end)

                                task.delay(40, function()
                                    if not revoked then
                                        cookingDict[order] = cookingDict[order] - 1
                                        revoked = true
                                    end
                                end)
                            end
                        end
                    end

                    for _, oven in ipairs(ovens) do
                        local door = oven:FindFirstChild("Door")
                        local meter = door and door:FindFirstChild("Meter")
                        local surfaceGui = meter and meter:FindFirstChild("SurfaceGui")
                        local progress = surfaceGui and surfaceGui:FindFirstChild("ProgressBar")
                        local bar = progress and progress:FindFirstChild("Bar")

                        if door and bar and not oven.IsOpen.Value then
                            local color = bar.ImageColor3
                            local isNotCooking = not oven.IsCooking.Value
                            local colorIsWrong = (
                                Vector3.new(color.R, color.G, color.B)
                                - Vector3.new(0.871, 0.518, 0.224)
                            ).Magnitude > 0.1

                            if isNotCooking or colorIsWrong then
                                didSomething = true
                                teleportToKitchen()
                                local clickDetector = door:FindFirstChild("ClickDetector")
                                local detector = clickDetector and clickDetector:FindFirstChild("Detector")
                                if detector then
                                    detector:FireServer()
                                end
                                break
                            end
                        end
                    end

                    task.spawn(function()
                        for _, dough in ipairs(workspace.AllDough:GetChildren()) do
                            for _, oven in ipairs(workspace.Ovens:GetChildren()) do
                                local bottom = oven:FindFirstChild("Bottom")
                                if bottom
                                    and (dough.Position - bottom.Position).Magnitude <= 3
                                    and not oven.IsCooking.Value
                                    and dough.BrickColor.Name ~= "Bright orange" then
                                    local door = oven:FindFirstChild("Door")
                                    local clickDetector = door and door:FindFirstChild("ClickDetector")
                                    local detector = clickDetector and clickDetector:FindFirstChild("Detector")
                                    if detector then
                                        detector:FireServer()
                                    end
                                end
                            end
                        end
                    end)

                    task.spawn(function()
                        for _, oven in ipairs(workspace.Ovens:GetChildren()) do
                            local bottom = oven:FindFirstChild("Bottom")
                            if bottom then
                                for _, boxedItem in ipairs(workspace.BoxingRoom:GetChildren()) do
                                    if (boxedItem.Position - bottom.Position).Magnitude <= 3 then
                                        network:FireServer(
                                            "UpdateProperty",
                                            boxedItem,
                                            "CFrame",
                                            CFrame.new(RNG:NextNumber(56, 57), 4.1, 38)
                                        )
                                        break
                                    end
                                end
                            end
                        end
                    end)

                    if badDew then
                        didSomething = true
                        network:FireServer(
                            "UpdateProperty",
                            badDew,
                            "CFrame",
                            CFrame.new(RNG:NextNumber(28, 30), 1.7, RNG:NextNumber(55, 57))
                        )
                    end

                    if trash and trash:FindFirstChild("IsBurned") then
                        local oven = getOvenNear(trash.Position)
                        if not trash.IsBurned.Value or not oven or oven.IsOpen.Value then
                            didSomething = true
                            network:FireServer(
                                "UpdateProperty",
                                trash,
                                "CFrame",
                                CFrame.new(47.90, 7.00, 72.49, 1, 0, 0, 0, 0, 1, 0, -1, 0)
                            )
                        end
                    end

                    return didSomething
                end

                player.PlayerScripts.LocalMain.Disabled = false

                while cookEnabled do
                    for _ = 1, 18 do
                        if not cookEnabled then
                            break
                        end

                        if not cookStep() then
                            break
                        end

                        task.wait(0.5)
                    end

                    task.wait(0.9)
                end
            end)
        end
    })
end

Tab:AddSection("Boxer Stuff")

do
    local player = Players.LocalPlayer
    local network = Network
    local boxerEnabled = false
    local boxerWorkerRunning = false

    Tab:AddToggle({
        Name = "Boxer",
        Default = false,
        Callback = function(Value)
            boxerEnabled = Value
            if not Value or boxerWorkerRunning then
                return
            end

            boxerWorkerRunning = true
            task.spawn(function()
                local boxPtick = 0
                local boxDtick = 0
                local random = Random.new()
                local stationPosition = Vector3.new(62.74, 6.59, 9.48)

                local function getRoot()
                    local character = player.Character
                    return character and character:FindFirstChild("HumanoidRootPart")
                end

                local function moveToStation()
                    local root = getRoot()
                    if not root then
                        return false
                    end
                    if (root.Position - stationPosition).Magnitude > 9 then
                        root.CFrame = CFrame.new(stationPosition)
                        task.wait(0.1)
                        return false
                    end
                    return true
                end

                local function findBoxes()
                    local closedBox, openBox, fullBox
                    for _, box in ipairs(workspace.AllBox:GetChildren()) do
                        local hasPizzaInside = box:FindFirstChild("HasPizzaInside")
                        local pizza = box:FindFirstChild("Pizza")
                        if box.Name == "BoxClosed" and hasPizzaInside and not hasPizzaInside.Value and not box.Anchored then
                            closedBox = closedBox or box
                        elseif box.Name == "BoxOpen" and pizza and not pizza.Value and not box.Anchored then
                            openBox = openBox or box
                        elseif box.Name == "BoxOpen" and pizza and pizza.Value then
                            fullBox = fullBox or box
                        elseif box.Name == "BoxClosed" and hasPizzaInside and hasPizzaInside.Value then
                            fullBox = fullBox or box
                        end
                        if closedBox and openBox and fullBox then
                            break
                        end
                    end
                    return closedBox, openBox, fullBox
                end

                local function findBoxingFoods()
                    local pizza, dew
                    for _, food in ipairs(workspace.BoxingRoom:GetChildren()) do
                        if not food.Anchored then
                            if not pizza and food.Name == "Pizza" then
                                pizza = food
                            elseif not dew and food.Name == "Dew" then
                                dew = food
                            end
                            if pizza and dew then
                                break
                            end
                        end
                    end
                    return pizza, dew
                end

                while boxerEnabled do
                    task.wait(0.9)
                    if not boxerEnabled then
                        break
                    end

                    local character = player.Character
                    local root = getRoot()
                    if not character or not root then
                        continue
                    end

                    local drawer = workspace:FindFirstChild("Drawer")
                    local slicerInDrawer = drawer and drawer:FindFirstChild("Pizza Slicer")
                    local slicerInBackpack = player.Backpack:FindFirstChild("Pizza Slicer")
                    if slicerInDrawer then
                        slicerInDrawer.ClickDetector.Detector:FireServer()
                    elseif not character:FindFirstChild("Pizza Slicer") and slicerInBackpack then
                        slicerInBackpack.Parent = character
                    end

                    local boxingRoom = workspace:FindFirstChild("BoxingRoom")
                    if boxingRoom then
                        for _, item in ipairs(boxingRoom:GetChildren()) do
                            network:FireServer("UpdateProperty", item, "Anchored", false)
                        end
                    end

                    local itemCount = #workspace.AllBox:GetChildren() + #workspace.BoxingRoom:GetChildren() + 1
                    for _ = 1, itemCount do
                        if not boxerEnabled then
                            break
                        end

                        local didSomething = false
                        local pizza, dew = findBoxingFoods()
                        local closedBox, openBox, fullBox = findBoxes()

                        if dew and tick() - boxDtick > 0.8 then
                            boxDtick = tick()
                            didSomething = true
                            if moveToStation() then
                                network:FireServer(
                                    "UpdateProperty",
                                    dew,
                                    "CFrame",
                                    CFrame.new(63, 4.9, -1, -1, 0, 0, 0, 1, 0, 0, 0, -1)
                                )
                            end
                        end

                        if fullBox then
                            if fullBox.Name == "BoxOpen" then
                                didSomething = true
                                if moveToStation() then
                                    network:FireServer("CloseBox", fullBox)
                                end
                            elseif tick() - boxPtick > 0.8 then
                                didSomething = true
                                if moveToStation() then
                                    network:FireServer(
                                        "UpdateProperty",
                                        fullBox,
                                        "CFrame",
                                        CFrame.new(68.2, 4.4, random:NextNumber(-3, -2), -1, 0, 0, 0, 1, 0, 0, 0, -1)
                                    )
                                    boxPtick = tick()
                                end
                            end
                        end

                        if closedBox and not openBox then
                            didSomething = true
                            if moveToStation() then
                                network:FireServer(
                                    "UpdateProperty",
                                    closedBox,
                                    "CFrame",
                                    CFrame.new(random:NextNumber(62.5, 70.5), 3.5, random:NextNumber(11, 25))
                                )
                                task.wait()
                                fireLearned("\x03:BoxClosed", "\x03", closedBox,
                                    "Open one pizza box by hand once so I can learn the remote.")
                            end
                        end

                        if openBox and pizza then
                            didSomething = true
                            if moveToStation() then
                                network:FireServer("UpdateProperty", pizza, "Anchored", true)
                                network:FireServer("UpdateProperty", openBox, "Anchored", true)
                                task.wait()
                                network:FireServer("UpdateProperty", pizza, "CFrame", openBox.CFrame + Vector3.new(0, -2, 0))
                                task.wait()
                                network:FireServer("AssignPizzaToBox", openBox, pizza)
                                task.wait()
                                network:FireServer("SlicePizza", openBox, random:NextInteger(10000, 40081))
                            end
                        end

                        if didSomething then
                            task.wait(0.5)
                        else
                            break
                        end
                    end
                end

                boxerWorkerRunning = false
            end)
        end
    })
