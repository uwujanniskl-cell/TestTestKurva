        topbar.InputBegan:Connect(function(input)
            if isPointerDown(input) then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
            end
        end)

        local resizing, rStart, rSize, rPos
        grip.InputBegan:Connect(function(input)
            if isPointerDown(input) then
                resizing = true
                rStart = input.Position
                rSize = main.Size
                rPos = main.Position
            end
        end)

        connect(UserInputService.InputChanged, function(input)
            if not isPointerMove(input) then return end
            if dragging then
                local d = (input.Position - dragStart) / uiScale.Scale
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            elseif resizing then
                local d = (input.Position - rStart) / uiScale.Scale
                local cam = workspace.CurrentCamera
                local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
                local maxW = math.max(300, math.min(900, (vp.X - 16) / uiScale.Scale))
                local maxH = math.max(240, math.min(640, (vp.Y - 16) / uiScale.Scale))
                local w = math.clamp(rSize.X.Offset + d.X, math.min(460, maxW), maxW)
                local h = math.clamp(rSize.Y.Offset + d.Y, math.min(300, maxH), maxH)
                main.Size = UDim2.fromOffset(w, h)
                main.Position = UDim2.new(
                    rPos.X.Scale, rPos.X.Offset + (w - rSize.X.Offset) * uiScale.Scale / 2,
                    rPos.Y.Scale, rPos.Y.Offset + (h - rSize.Y.Offset) * uiScale.Scale / 2
                )
            end
        end)
        connect(UserInputService.InputEnded, function(input)
            if isPointerDown(input) then
                dragging = false
                resizing = false
            end
        end)
    end

