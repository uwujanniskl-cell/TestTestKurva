do
    local cashier = {session = 0, ready = false, part = nil}

    local function setupCashier()
        if cashier.ready then return true end

        local TARGET_REGISTER = workspace:WaitForChild("Register3")
        local REACH_DISTANCE = 12
        local CLICK_BUBBLE_DELAY_MS = 50
        local SELECT_RESPONSE_DELAY_MS = 100
        local ORDER_COMPLETE_DELAY_MS = 250
        local MIN_CYCLE_DELAY_MS = 270
        local MAX_CYCLE_DELAY_MS = 320

        local function waitMs(ms) task.wait(ms / 1000) end

        local EventHandler
        for _, v in pairs(getgc()) do
            if typeof(v) == "function" then
                local info = debug.getinfo(v)
                if info and info.name == "GetEventHandler" then
                    EventHandler = v
                    break
                end
            end
        end
        if not EventHandler then warn("[Cashier] GetEventHandler not found") return false end

        local ok, Table2 = pcall(getupvalue, EventHandler, 1)
        if not ok or type(Table2) ~= "table" then warn("[Cashier] Failed to get upvalue table") return false end

        for i, v in pairs(Table2) do
            if i == "OrderComplete" and typeof(v) == "table" and v.Remote then
                v.Remote.Name = i
            end
        end

        local Events = ReplicatedStorage:WaitForChild("Communication"):WaitForChild("Events")

        local function FindChildByIndexSequence(Parent, IndexSequence)
            local Current = Parent
            for _, Index in ipairs(IndexSequence) do
                if not Current then return nil end
                Current = Current:FindFirstChild(tostring(Index))
            end
            return Current
        end

        local function GetDistanceToCustomer(customerHRP)
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp or not customerHRP then return math.huge end
            return (hrp.Position - customerHRP.Position).Magnitude
        end

        local InstantTalk = {Timeout = 8, LastHandled = {}}
        InstantTalk.OrderConnection = workspace.GameService.RecivedCustomerOrder.OnClientEvent

        function InstantTalk:CanTalkToCustomer(Customer)
            local Head = Customer:FindFirstChild("Head")
            if not Head then return false end

            local bubblesGui = LocalPlayer.PlayerGui:FindFirstChild("CustomerBubbles")
            local hasVisibleBubble = false
            if bubblesGui then
                for _, v in ipairs(bubblesGui:GetChildren()) do
                    if v.Adornee == Head and v.Enabled then
                        hasVisibleBubble = true
                        break
                    end
                end
            end

            local dist = GetDistanceToCustomer(Customer:FindFirstChild("HumanoidRootPart"))
            local last = self.LastHandled[Customer:GetDebugId()]
            if last and tick() - last < 0.3 then return false end

            return hasVisibleBubble and dist <= REACH_DISTANCE
        end

        function InstantTalk:HandleCustomer(Customer)
            local correct = FindChildByIndexSequence(Customer, {"Head", "DialogSimple", "Correct"})
            if not correct then return false end
            local head = Customer.Head

            workspace.Dialog:FireServer("ClickedBubble", head)
            waitMs(CLICK_BUBBLE_DELAY_MS)
            workspace.Dialog:FireServer("ResponseSelected", correct, head)
            waitMs(SELECT_RESPONSE_DELAY_MS)

            local OrderString
            local conn
            conn = self.OrderConnection:Connect(function(Order)
                OrderString = Order
                conn:Disconnect()
            end)

            local t = 0
            repeat task.wait(0.1) t += 0.1 until OrderString or t >= self.Timeout

            if OrderString then
                waitMs(ORDER_COMPLETE_DELAY_MS)
                Events.OrderComplete:FireServer(Customer, OrderString, TARGET_REGISTER)
                Customer:SetAttribute("AlreadyHandled", true)
                self.LastHandled[Customer:GetDebugId()] = tick()
                return true
            end

            conn:Disconnect()
            return false
        end

        function cashier.run(session)
            while cashier.session == session do
                local handled = false
                for _, Customer in ipairs(workspace.Customers:GetChildren()) do
                    if cashier.session ~= session then break end
                    if InstantTalk:CanTalkToCustomer(Customer) then
                        handled = InstantTalk:HandleCustomer(Customer)
                        break
                    end
                end

                if handled then
                    waitMs(math.random(MIN_CYCLE_DELAY_MS, MAX_CYCLE_DELAY_MS))
                else
                    task.wait(0.05)
                end
            end
        end

        cashier.ready = true
        return true
    end

    Tab:AddToggle({
        Name = "Legit Cashier",
        Default = false,
        Callback = function(Value)
            cashier.session += 1

            if cashier.part then
                cashier.part:Destroy()
                cashier.part = nil
            end

            if not Value then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= Players.LocalPlayer and p.Character and p.Character.Parent == nil then
                        p.Character.Parent = workspace
                    end
                end
                return
            end

            if not setupCashier() then return end

            local character = Players.LocalPlayer.Character or Players.LocalPlayer.CharacterAdded:Wait()
            character:WaitForChild("HumanoidRootPart")
            local size = character:GetExtentsSize()

            local part = Instance.new("Part")
            part.Size = Vector3.new(size.X, 0.2, size.Z)
            part.Anchored = true
            part.CanCollide = false
            part.Color = Color3.fromRGB(0, 255, 0)
            part.Material = Enum.Material.Neon
            part.CFrame = CFrame.new(48.5161629, 3.80013371, 112.588791, -0.999803782, 7.88716221e-08, 0.0198089201, 7.8796603e-08, 1, -4.56750016e-09, -0.0198089201, -3.00572833e-09, -0.999803782)
            part.Parent = workspace
            cashier.part = part

            task.spawn(cashier.run, cashier.session)
        end
    })
end

