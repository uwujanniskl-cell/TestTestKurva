    local RunService = game:GetService("RunService")
    local sessionStart = os.clock()
    local fps = 60
    do
        local frames, last = 0, os.clock()
        connect(RunService.Heartbeat, function()
            frames += 1
            local now = os.clock()
            if now - last >= 1 then
                fps = frames
                frames, last = 0, now
            end
        end)
    end

    local infoTab

    -- matches your username or display name
    local function isMe(text)
        local me = Players.LocalPlayer
        text = tostring(text or ""):lower()
        return text == me.Name:lower() or text == me.DisplayName:lower()
    end

    -- 1234567 -> 1.234.567
    local function formatDots(n)
        local str = string.format("%.0f", n)
        local sign, digits = str:match("^(-?)(%d+)$")
        digits = digits:reverse():gsub("(%d%d%d)", "%1."):reverse()
        if digits:sub(1, 1) == "." then digits = digits:sub(2) end
        return sign .. digits
    end

    local function getLeaderboardResult()
        local leaderboards = workspace:FindFirstChild("Leaderboards")
        local board = leaderboards and leaderboards:FindFirstChild("MostOrdersWeekly")
        local scrolling = board and board:FindFirstChildWhichIsA("ScrollingFrame", true)
        if not scrolling then
            return nil, "MostOrdersWeekly leaderboard UI is unavailable."
        end
        for _, r in ipairs(scrolling:GetChildren()) do
            local nameLabel = r:FindFirstChild("PlayerName", true)
            if nameLabel and nameLabel:IsA("TextLabel") and isMe(nameLabel.Text) then
                local rankLabel = r:FindFirstChild("Rank", true)
                local statLabel = r:FindFirstChild("Stat", true)
                if not (rankLabel and rankLabel:IsA("TextLabel") and statLabel and statLabel:IsA("TextLabel")) then
                    return nil, "Leaderboard row is missing its rank or order label."
                end
                return { rank = rankLabel.Text, orders = statLabel.Text }
            end
        end
        return { rank = "-", orders = "-" }
    end

    local function getMoneyResult()
        local me = Players.LocalPlayer
        local balance = me:FindFirstChild("Moneyz") or me:FindFirstChild("Moneyz", true)

        local current = "unavailable"
        if balance and (balance:IsA("IntValue") or balance:IsA("NumberValue")) then
            current = formatDots(balance.Value)
        end

        local listText = "unavailable"
        local reason
        local playerGui = me:FindFirstChildOfClass("PlayerGui")
        local mainGui = playerGui and playerGui:FindFirstChild("MainGui")
        local playerList = mainGui and mainGui:FindFirstChild("PlayerList", true)

        if not playerList then
            reason = "Player list not found."
        else
            for _, r in ipairs(playerList:GetChildren()) do
                local nameLabel = r:FindFirstChild("PlayerName", true)
                if nameLabel and nameLabel:IsA("TextLabel") and isMe(nameLabel.Text) then
                    local moneyLabel = r:FindFirstChild("Moneyz", true)
                    if moneyLabel and moneyLabel:IsA("TextLabel") then
                        listText = moneyLabel.Text
                    else
                        reason = "Moneyz label missing in your player-list row."
                    end
                    break
                end
            end
            if listText == "unavailable" and not reason then
                reason = "Your row was not found on the player list."
            end
        end

        if current == "unavailable" and reason then
            return nil, "Moneyz value not found. " .. reason
        end
        return { current = current, playerList = listText, note = reason }
    end

    function Window:OpenPlayerInfo()
        if not infoTab then
            local plr = Players.LocalPlayer
            infoTab = Window:AddTab("Player Info", Icons.Home, true)

            infoTab:AddSection("Account")
            local lUser    = infoTab:AddLabel("")
            local lDisplay = infoTab:AddLabel("")
            local lId      = infoTab:AddLabel("")
            local lAge     = infoTab:AddLabel("")
            local lMember  = infoTab:AddLabel("")

            infoTab:AddSection("Leaderboard & Money")
            local lRank     = infoTab:AddLabel("")
            local lOrders   = infoTab:AddLabel("")
            local lMoney    = infoTab:AddLabel("")
            local lListMoney = infoTab:AddLabel("")
            local lNotes    = infoTab:AddLabel("")

            infoTab:AddSection("Character")
            local lTeam   = infoTab:AddLabel("")
            local lHealth = infoTab:AddLabel("")
            local lSpeed  = infoTab:AddLabel("")
            local lPos    = infoTab:AddLabel("")

            infoTab:AddSection("Session")
            local lPing    = infoTab:AddLabel("")
            local lFps     = infoTab:AddLabel("")
            local lPlayers = infoTab:AddLabel("")
            local lTime    = infoTab:AddLabel("")
            local lPlace   = infoTab:AddLabel("")

            infoTab:AddSection("Actions")
            infoTab:AddButton({ Name = "Copy User ID", Callback = function()
                if setclipboard then
                    setclipboard(tostring(plr.UserId))
                    Window:Notify({ Title = "Copied", Content = "User ID copied", Duration = 2 })
                end
            end })
            infoTab:AddButton({ Name = "Copy Job ID", Callback = function()
                if setclipboard then
                    setclipboard(game.JobId)
                    Window:Notify({ Title = "Copied", Content = "Job ID copied", Duration = 2 })
                end
            end })

            local function update()
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")

                lUser:Set("Username:  " .. plr.Name)
                lDisplay:Set("Display name:  " .. plr.DisplayName)
                lId:Set("User ID:  " .. plr.UserId)
                lAge:Set("Account age:  " .. plr.AccountAge .. " days")
                lMember:Set("Membership:  " .. plr.MembershipType.Name)

                lTeam:Set("Team:  " .. (plr.Team and plr.Team.Name or "None"))
                lHealth:Set("Health:  " .. (hum and (math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)) or "N/A"))
                lSpeed:Set("WalkSpeed / JumpPower:  " .. (hum and (hum.WalkSpeed .. " / " .. hum.JumpPower) or "N/A"))
                lPos:Set("Position:  " .. (root and string.format("%.1f, %.1f, %.1f", root.Position.X, root.Position.Y, root.Position.Z) or "N/A"))

                local okPing, ping = pcall(function() return plr:GetNetworkPing() * 1000 end)
                lPing:Set("Ping:  " .. (okPing and (math.floor(ping) .. " ms") or "N/A"))
                lFps:Set("FPS:  " .. fps)
                lPlayers:Set("Players in server:  " .. #Players:GetPlayers() .. " / " .. Players.MaxPlayers)
                local t = math.floor(os.clock() - sessionStart)
                lTime:Set(string.format("Time in script:  %02d:%02d:%02d", t // 3600, (t % 3600) // 60, t % 60))
                lPlace:Set("Place ID:  " .. game.PlaceId)

                local leaderboard, lbErr = getLeaderboardResult()
                local money, moneyErr = getMoneyResult()
                local notes = {}
                if lbErr then table.insert(notes, lbErr) end
                if moneyErr then table.insert(notes, moneyErr) end
                if money and money.note then table.insert(notes, money.note) end

                lRank:Set("Leaderboard rank (Orders, weekly):  " .. (leaderboard and leaderboard.rank or "unavailable"))
                lOrders:Set("Orders:  " .. (leaderboard and leaderboard.orders or "unavailable"))
                lMoney:Set("Current Moneyz:  " .. (money and money.current or "unavailable"))
                lListMoney:Set("Player list Moneyz:  " .. (money and money.playerList or "unavailable"))
                lNotes:Set(#notes > 0 and ("Notes:  " .. table.concat(notes, " | ")) or "Notes:  none")
            end

            update()
            task.spawn(function()
                while gui.Parent do
                    task.wait(0.5)
                    pcall(update)
                end
            end)
        end
        infoTab.Select()
    end

