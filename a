local function findPlayerByName(text)
    text = string.lower(tostring(text or ""))
    if text == "" then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Players.LocalPlayer then
            if string.lower(plr.Name):find(text, 1, true) or string.lower(plr.DisplayName):find(text, 1, true) then
                return plr
            end
        end
    end
end

Player = {
    GetCharacter = function(name)
        local plr = findPlayerByName(name)
        return plr and plr.Character
    end
}

function Pplr(name)
    local plr = findPlayerByName(name)
    local char = plr and plr.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

function Camera(target, follow)
    local cam = workspace.CurrentCamera
    local lp = Players.LocalPlayer
    local model = target
    if typeof(target) == "Instance" and not target:IsA("Model") then
        model = target:FindFirstAncestorOfClass("Model")
    end
    local hum
    if follow and model then
        hum = model:FindFirstChildOfClass("Humanoid")
    else
        hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    end
    if hum then cam.CameraSubject = hum end
end

