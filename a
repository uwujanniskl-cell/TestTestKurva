function Library:SaveConfig(name)
    if not writefile then return false, "writefile is not available here" end
    local ok, err = pcall(function()
        if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
        writefile(CONFIG_FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode(self.Flags))
    end)
    return ok, err
end

function Library:LoadConfig(name)
    if not (readfile and isfile) then return false, "readfile is not available here" end
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(path) then return false, "config not found" end
    local ok, err = pcall(function()
        local data = HttpService:JSONDecode(readfile(path))
        for flag, value in pairs(data) do
            local setter = self._setters[flag]
            if setter then setter(value) end
        end
    end)
    return ok, err
end

