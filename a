------------------------------------------------------------------
-- Auto-learn for obfuscated remotes
-- Some actions (SquishDough, OpenBox, ...) now go through a remote in
-- ReplicatedStorage.Communication.Functions whose position changes every
-- join and whose name is empty. We watch the game's own call
--     <Functions remote>:FireServer("\xNN", <Instance>)
-- and remember the remote per "opcode:InstanceName", e.g. "\x01:Dough".
------------------------------------------------------------------
local Learned = {}
do
    local ok, err = pcall(function()
        assert(hookmetamethod and getnamecallmethod, "executor lacks hookmetamethod")
        local wrap = newcclosure or function(f) return f end
        local old
        old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
            if getnamecallmethod() == "FireServer"
                and typeof(self) == "Instance"
                and self.ClassName == "RemoteEvent"
                and self.Parent and self.Parent.Name == "Functions" then
                local a, b = ...
                if type(a) == "string" and #a == 1 and typeof(b) == "Instance" then
                    Learned[a .. ":" .. b.Name] = self
                end
            end
            return old(self, ...)
        end))
    end)
    if not ok then warn("[Learn] auto-learn unavailable:", err) end
end

local lastLearnHint = {}
-- fires the learned remote; returns false (and nags once per 30s) if not learned yet
local function fireLearned(key, opcode, arg, hint)
    local remote = Learned[key]
    if remote and remote.Parent then
        remote:FireServer(opcode, arg)
        return true
    end
    if os.clock() - (lastLearnHint[key] or -math.huge) > 30 then
        lastLearnHint[key] = os.clock()
        Window:Notify({ Title = "Learning remote", Content = hint, Duration = 6 })
    end
    return false
end

