            return
        end

        local status = response and (response.StatusCode or response.Status)
        if not response or response.Success == false
            or (type(status) == "number" and (status < 200 or status >= 300)) then
            warn("Webhook returned: " .. tostring(status) .. " " .. tostring(response and response.Body))
