local resolveCache = {}

local function parseIcon(icon)
    if icon == nil then return nil end
    if type(icon) == "number" then
        return "image", "rbxassetid://" .. icon
    end
    if type(icon) == "string" then
        if icon == "" or icon == "rbxassetid://0" or icon == "0" then return nil end
        if icon:match("^rbxassetid://%d+$") or icon:match("^rbxasset://") then
            return "image", icon
        end
        if icon:match("^%d+$") then
            return "image", "rbxassetid://" .. icon
        end
        return "text", icon
    end
    return nil
end

local function resolveDecal(imageUrl, apply)
    if resolveCache[imageUrl] then
        if resolveCache[imageUrl] ~= imageUrl then apply(resolveCache[imageUrl]) end
        return
    end
    task.spawn(function()
        local result = imageUrl
        if imageUrl:match("^rbxassetid://%d+$") then
            local ok, objs = pcall(function() return game:GetObjects(imageUrl) end)
            if ok and type(objs) == "table" and objs[1] then
                local o = objs[1]
                if (o:IsA("Decal") or o:IsA("Texture")) and o.Texture ~= "" then
                    result = o.Texture
                end
                pcall(function() o:Destroy() end)
            end
        end
        resolveCache[imageUrl] = result
        if result ~= imageUrl then apply(result) end
    end)
end

local function makeIcon(parent, icon, size, color)
    local kind, value = parseIcon(icon)
    if not kind then return nil end
    if kind == "image" then
        local img = create("ImageLabel", {
            Size = UDim2.fromOffset(size, size),
            BackgroundTransparency = 1,
            Image = value,
            ScaleType = Enum.ScaleType.Fit,
            Parent = parent,
        })
        if Library.AutoResolveDecals then
            resolveDecal(value, function(resolved)
                if img.Parent then img.Image = resolved end
            end)
        end
        return img
    end
    return create("TextLabel", {
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
        Text = value,
        TextSize = size - 2,
        Font = Enum.Font.GothamBold,
        TextColor3 = color or Theme.Text,
        Parent = parent,
    })
end

local function setIconActive(icon, active)
    if not icon then return end
    if icon:IsA("ImageLabel") then
        tween(icon, { ImageTransparency = active and 0 or 0.5 })
    else
        tween(icon, { TextColor3 = active and Theme.Accent or Theme.SubText })
    end
end

