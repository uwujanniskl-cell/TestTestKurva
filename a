local function new(class, props, children)
	local obj = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			obj[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = obj
	end
	obj.Parent = parent
	return obj
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) })
end

local function stroke(color, thickness, transparency)
	return new("UIStroke", {
		Color = color or THEME.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function tween(obj, props, t)
	TweenService:Create(obj, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function fire(callback, ...)
	if typeof(callback) ~= "function" then return end
	local ok, err = pcall(callback, ...)
	if not ok then
		warn("[CorpseGUI] callback error: " .. tostring(err))
	end
end

local function getGuiParent()
	-- 1) CoreGui (requires an executor/context with CoreGui access)
	local ok, core = pcall(function()
		local cg = game:GetService("CoreGui")
		local test = Instance.new("Folder")
		test.Parent = cg -- errors if access is denied
		test:Destroy()
		return cg
	end)
	if ok and core then return core end

	-- 2) fallback: gethui()
	if typeof(gethui) == "function" then
		local ok2, ui = pcall(gethui)
		if ok2 and ui then return ui end
	end

	-- 3) fallback: PlayerGui
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

