	local connections = {}
	local function connect(signal, fn)
		local c = signal:Connect(fn)
		table.insert(connections, c)
		return c
	end

	local gui = new("ScreenGui", {
		Name = "CorpseGUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = getGuiParent(),
	})

	local main = new("Frame", {
		Name = "Main",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(WIN_W, WIN_H),
		Position = UDim2.fromScale(0.5, 0.5),
		Visible = false,
		BackgroundColor3 = THEME.Background,
		BorderSizePixel = 0,
		Parent = gui,
	}, { corner(10), stroke(THEME.Stroke, 1) })

	-- Scales the window down on small screens (phones/tablets) so it always fits
	local function fit()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		return math.clamp(math.min((vp.X - 16) / WIN_W, (vp.Y - 16) / WIN_H), 0.45, 1)
	end
	local scale = new("UIScale", { Scale = fit(), Parent = main })
	local visible = false
	local function setVisible(v)
		if v == visible then return end
		visible = v
		if v then
			main.Visible = true
			scale.Scale = fit() * 0.96
			tween(scale, { Scale = fit() }, 0.15)
		else
			tween(scale, { Scale = fit() * 0.96 }, 0.12)
			task.delay(0.12, function()
				if not visible then main.Visible = false end
			end)
		end
	end
	do
		local cam = workspace.CurrentCamera
		if cam then
			connect(cam:GetPropertyChangedSignal("ViewportSize"), function()
				if visible then scale.Scale = fit() end
			end)
		end
	end
	function Window:SetVisible(v) setVisible(v) end
	function Window:Toggle() setVisible(not visible) end

